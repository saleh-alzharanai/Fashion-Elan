{% extends "layouts.master" %}

{% block content %}
  <div class="container mx-auto px-4 py-16 max-w-3xl">
    <header class="mb-10 text-center">
      <h1 class="font-serif text-3xl lg:text-4xl font-light text-neutral-900 tracking-tight">
        {{ page.title }}
      </h1>
      <div class="w-12 h-px bg-neutral-300 mx-auto mt-6"></div>
    </header>

    <div class="prose prose-neutral max-w-none leading-relaxed text-neutral-700 text-sm">
      {{ page.content|raw }}
    </div>
  </div>
{% endblock %}
