{% extends "layouts.master" %}

{% block content %}
  <div class="container mx-auto px-4 py-12 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      
      {# Product Media Gallery #}
      <div class="product-gallery space-y-4">
        {% if product.images|length > 0 %}
          <div class="aspect-[3/4] bg-neutral-100 overflow-hidden rounded-sm">
            <img 
              src="{{ product.image.url }}" 
              alt="{{ product.image.alt|default(product.name) }}" 
              class="w-full h-full object-cover object-center"
            >
          </div>
          {% if product.images|length > 1 %}
            <div class="grid grid-cols-4 gap-4">
              {% for image in product.images %}
                <div class="aspect-[3/4] bg-neutral-100 overflow-hidden cursor-pointer rounded-sm hover:opacity-80 transition-opacity">
                  <img src="{{ image.url }}" alt="{{ product.name }}" class="w-full h-full object-cover">
                </div>
              {% endfor %}
            </div>
          {% endif %}
        {% else %}
          <div class="aspect-[3/4] bg-neutral-100 flex items-center justify-center text-neutral-400">
            <span>No Image Available</span>
          </div>
        {% endif %}
      </div>

      {# Product Information & Actions #}
      <div class="product-details space-y-8 sticky top-24">
        <div>
          {% if product.brand %}
            <span class="text-xs uppercase tracking-widest text-neutral-400 font-medium block mb-2">
              {{ product.brand.name }}
            </span>
          {% endif %}
          <h1 class="font-serif text-3xl lg:text-4xl font-light text-neutral-900 tracking-tight">
            {{ product.name }}
          </h1>
          <div class="mt-4 flex items-center space-x-4 space-x-reverse">
            {% if product.is_on_sale %}
              <span class="text-xl font-medium text-neutral-900">{{ product.sale_price|money }}</span>
              <span class="text-lg text-neutral-400 line-through">{{ product.regular_price|money }}</span>
            {% else %}
              <span class="text-xl font-medium text-neutral-900">{{ product.price|money }}</span>
            {% endif %}
          </div>
        </div>

        {# Product Options / Variants #}
        {% if product.has_options %}
          <salla-product-options options="{{ product.options }}"></salla-product-options>
        {% endif %}

        {# Add to Cart Button #}
        <div class="space-y-4 pt-4 border-t border-neutral-100">
          <salla-add-product-button 
            product-id="{{ product.id }}" 
            support-options
            class="w-full bg-black text-white py-4 uppercase tracking-widest text-xs font-semibold hover:bg-neutral-800 transition-colors"
          >
            {{ trans('theme.product.quick_add')|default('Add to Bag') }}
          </salla-add-product-button>
        </div>

        {# Description #}
        {% if product.description %}
          <div class="prose prose-neutral text-sm leading-relaxed text-neutral-600 pt-6 border-t border-neutral-100">
            <h3 class="text-xs uppercase tracking-widest text-neutral-900 font-semibold mb-3">
              Description & Fit
            </h3>
            <div>{{ product.description|raw }}</div>
          </div>
        {% endif %}

      </div>

    </div>
  </div>
{% endblock %}
