{% extends "layouts.master" %}

{% block content %}
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <h1 class="font-serif text-3xl font-light tracking-wide text-neutral-900 mb-8 pb-4 border-b border-neutral-200">
      {{ trans('theme.header.cart')|default('Shopping Bag') }}
    </h1>

    {% if cart.items|length > 0 %}
      <div class="space-y-8">
        {# Cart Items List #}
        <div class="divide-y divide-neutral-100">
          {% for item in cart.items %}
            <div class="py-6 flex items-center justify-between space-x-4 space-x-reverse">
              <div class="flex items-center space-x-4 space-x-reverse">
                <div class="w-20 h-24 bg-neutral-100 overflow-hidden flex-shrink-0">
                  <img src="{{ item.product.image.url }}" alt="{{ item.product.name }}" class="w-full h-full object-cover">
                </div>
                <div>
                  <h2 class="font-serif text-lg text-neutral-900">{{ item.product.name }}</h2>
                  <p class="text-sm text-neutral-500 mt-1">
                    {{ item.quantity }} × {{ item.price|money }}
                  </p>
                </div>
              </div>
              <div class="text-right">
                <span class="font-medium text-neutral-900 block mb-2">{{ item.total|money }}</span>
              </div>
            </div>
          {% endfor %}
        </div>

        {# Summary & Checkout #}
        <div class="bg-neutral-50 p-6 rounded-sm space-y-4">
          <div class="flex justify-between text-base font-medium text-neutral-900">
            <span>Subtotal</span>
            <span>{{ cart.subtotal|money }}</span>
          </div>
          <p class="text-xs text-neutral-500">Shipping and taxes calculated at checkout.</p>
          <a 
            href="{{ cart.checkout_url }}" 
            class="block w-full text-center bg-black text-white py-4 text-xs font-semibold uppercase tracking-widest hover:bg-neutral-800 transition-colors"
          >
            Proceed to Checkout
          </a>
        </div>
      </div>
    {% else %}
      <div class="text-center py-16 space-y-4">
        <p class="text-neutral-500 font-light">Your shopping bag is currently empty.</p>
        <a 
          href="/" 
          class="inline-block bg-black text-white px-8 py-3 text-xs font-semibold uppercase tracking-widest hover:bg-neutral-800 transition-colors"
        >
          Continue Shopping
        </a>
      </div>
    {% endif %}
  </div>
{% endblock %}
