<footer class="bg-[var(--color-surface-alt)] border-t border-[var(--color-border)] mt-20 pt-16 pb-12">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-[var(--color-border)]">
      
      <div class="md:col-span-4 space-y-4">
        <span class="text-xl font-serif font-bold uppercase tracking-wider text-[var(--color-text)]">{{ store.name }}</span>
        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed max-w-sm">
          {{ store.description }}
        </p>
      </div>

      <div class="md:col-span-4 grid grid-cols-2 gap-8">
        <div>
          <h4 class="text-xs uppercase tracking-widest font-semibold text-[var(--color-text)] mb-4">Navigation</h4>
          <ul class="space-y-2 text-xs text-[var(--color-text-muted)]">
            {% for item in footer_menu %}
              <li><a href="{{ item.url }}" class="hover:text-[var(--color-text)] transition-colors">{{ item.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="md:col-span-4 space-y-4">
        <h4 class="text-xs uppercase tracking-widest font-semibold text-[var(--color-text)]">{{ trans('theme.footer.newsletter_title') }}</h4>
        <div class="flex items-center max-w-md">
          <input type="email" placeholder="email@domain.com" class="w-full bg-[var(--color-surface)] border border-[var(--color-border)] px-4 py-3 text-xs focus:outline-none focus:border-[var(--color-primary)] transition-colors" />
          <button class="bg-[var(--color-primary)] text-white px-6 py-3 text-xs uppercase tracking-wider hover:bg-[var(--color-primary-hover)] transition-colors shrink-0">
            {{ trans('theme.footer.subscribe') }}
          </button>
        </div>
      </div>

    </div>

    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[10px] uppercase tracking-widest text-[var(--color-text-muted)]">
      <p>© {{ "now"|date("Y") }} {{ store.name }}. {{ trans('theme.footer.rights_reserved') }}.</p>
    </div>
  </div>
</footer>
