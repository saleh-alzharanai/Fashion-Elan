<section class="editorial-hero relative overflow-hidden bg-[var(--color-bg)] py-12 md:py-20">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      
      <div class="md:col-span-5 z-10 space-y-6 text-start">
        {% if component.subtitle %}
          <span class="text-xs uppercase tracking-widest text-[var(--color-accent)] font-semibold block">
            {{ component.subtitle }}
          </span>
        {% endif %}
        
        <h1 class="text-4xl md:text-6xl font-serif text-[var(--color-text)] leading-tight">
          {{ component.title }}
        </h1>
        
        {% if component.cta_url %}
          <div class="pt-4">
            <a href="{{ component.cta_url }}" 
               class="inline-block bg-[var(--color-primary)] text-white px-8 py-4 text-xs uppercase tracking-widest hover:bg-[var(--color-primary-hover)] transition-colors duration-300">
              {{ component.cta_text ?: trans('theme.editorial_hero.explore_collection') }}
            </a>
          </div>
        {% endif %}
      </div>

      <div class="md:col-span-7 relative">
        <div class="aspect-[4/5] w-full overflow-hidden bg-[var(--color-surface-alt)]">
          <picture>
            {% if component.mobile_image %}
              <source media="(max-width: 767px)" srcset="{{ component.mobile_image }}">
            {% endif %}
            <img src="{{ component.desktop_image ?: 'assets/images/placeholder-hero.webp' }}" 
                 alt="{{ component.title }}" 
                 loading="eager"
                 class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700 ease-out" />
          </picture>
        </div>
      </div>

    </div>
  </div>
</section>
