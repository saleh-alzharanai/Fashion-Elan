<!DOCTYPE html>
<html lang="{{ session.lang }}" dir="{{ session.dir }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ store.name }}</title>
    {# Load Salla Twilight Core Web Components and Styles #}
    {% hook 'head:start' %}
    <salla-head></salla-head>
    {% hook 'head:end' %}
</head>
<body class="bg-white text-neutral-900 antialiased">
    {% hook 'body:start' %}

    {# Header / Navigation Component #}
    {% include 'components.header.header' ignore missing %}

    {# Main Page Content Injection #}
    <main id="app">
        {% block content %}{% endblock %}
    </main>

    {# Footer Component #}
    {% include 'components.footer.footer' ignore missing %}

    {% hook 'body:end' %}
    <salla-scripts></salla-scripts>
</body>
</html>
