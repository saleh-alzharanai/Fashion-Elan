<!DOCTYPE html>
<html lang="{{ user.language }}" dir="{{ user.language == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ head | raw }}
    <link rel="stylesheet" href="{{ 'css/app.css' | asset }}">
</head>
<body class="bg-[var(--color-bg)] text-[var(--color-text)] flex flex-col min-h-screen">
    {% include 'components/header/header.twig' %}

    <main id="main-content" class="flex-grow">
        {% block content %}{% endblock %}
    </main>

    {% include 'components/footer/footer.twig' %}

    {{ footer | raw }}
</body>
</html>
