{
  "name": "Élan Atelier",
  "version": "1.0.0",
  "author": "Atelier Studio",
  "support_url": "https://example.com/support",
  "repository_url": "https://github.com/YOUR_USERNAME/elan-atelier",
  "features": [
    "dark_mode",
    "header_sticky",
    "product_zoom",
    "quick_view"
  ],
  "settings": [
    {
      "id": "brand_primary_color",
      "type": "color",
      "label": "Primary Color",
      "default": "#111111"
    },
    {
      "id": "editorial_font_family",
      "type": "select",
      "label": "Display Typography",
      "default": "serif",
      "options": [
        {
          "key": "serif",
          "value": "Editorial Serif"
        },
        {
          "key": "sans",
          "value": "Modern Sans"
        }
      ]
    },
    {
      "id": "enable_micro_animations",
      "type": "boolean",
      "label": "Enable Motion System",
      "default": true
    }
  ],
  "components": [
    {
      "name": "editorial-hero",
      "path": "components/home/editorial-hero.twig",
      "icon": "salla-icon-image",
      "label": "Editorial Fashion Hero",
      "fields": [
        {
          "id": "title",
          "type": "text",
          "label": "Headline",
          "default": "Autumn / Winter Collection"
        },
        {
          "id": "subtitle",
          "type": "text",
          "label": "Subheadline",
          "default": "Minimalist silhouettes designed for timeless elegance."
        },
        {
          "id": "desktop_image",
          "type": "image",
          "label": "Desktop Campaign Banner"
        },
        {
          "id": "mobile_image",
          "type": "image",
          "label": "Mobile Campaign Banner"
        },
        {
          "id": "cta_text",
          "type": "text",
          "label": "Button Label",
          "default": "Explore Collection"
        },
        {
          "id": "cta_url",
          "type": "url",
          "label": "Button Link"
        }
      ]
    },
    {
      "name": "lookbook-showcase",
      "path": "components/home/lookbook.twig",
      "icon": "salla-icon-grid",
      "label": "Editorial Lookbook Grid",
      "fields": [
        {
          "id": "section_title",
          "type": "text",
          "label": "Section Title",
          "default": "Shop By Look"
        },
        {
          "id": "look_image",
          "type": "image",
          "label": "Lookbook Editorial Image"
        }
      ]
    }
  ]
}
